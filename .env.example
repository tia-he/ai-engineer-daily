# Base URL of the FastAPI backend. Used both for server-side fetches
# (homepage, article detail) and as the destination for the /api/search
# rewrite proxy in next.config.ts.
#
# Local development (default if unset): http://127.0.0.1:8000
# Production: the public URL of your deployed backend (e.g. Render), no
# trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
