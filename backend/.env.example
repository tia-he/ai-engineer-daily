# Full SQLAlchemy connection string. Single source of truth for which
# database the app uses — no code changes needed to switch environments.
#
# Local development (default if unset):
#   postgresql+psycopg://postgres:postgres@localhost:5432/ai_engineer_daily
# Production (example, using a hosted Postgres provider like Neon):
#   postgresql+psycopg://user:password@your-db-host/ai_engineer_daily?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_engineer_daily

# Required for generate_ai.py (AI metadata generation). No default.
OPENAI_API_KEY=

# OpenAI model used for AI metadata generation.
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of origins allowed to call the API (CORS).
# Local development (default if unset): http://localhost:3000
# Production: the public URL of your deployed frontend (e.g. Vercel).
ALLOWED_ORIGINS=http://localhost:3000
